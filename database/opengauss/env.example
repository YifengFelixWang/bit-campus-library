# 复制为 .env，仅在本机填写 LIBRARY_LOCAL_PASSWORD。云主机由 E 另行配置。
OPENGAUSS_IMAGE=opengauss/opengauss:7.0.0-RC3.B025-amd64-openEuler22.03
OPENGAUSS_PLATFORM=linux/amd64
HOST=localhost
PORT=15432
DATABASE=library
INIT_USER=gaussdb
LIBRARY_LOCAL_PASSWORD=

# 下列业务用户都使用上面的本机口令。
DB_IAM_RUNTIME=db_iam_runtime
DB_CATALOG_READER01=db_catalog_reader01
DB_CATALOG_READER02=db_catalog_reader02
DB_CATALOG_LIBRARIAN01=db_catalog_librarian01
DB_LOAN_READER01=db_loan_reader01
DB_LOAN_READER02=db_loan_reader02
DB_LOAN_LIBRARIAN01=db_loan_librarian01
DB_REPORT_ANALYST01=db_report_analyst01
DB_REPORT_SYNC=db_report_sync
