# Docker Desktop host with D's initialized library database
LIBRARY_JDBC_URL=jdbc:opengauss://host.docker.internal:15432/library
# Database login passwords for db_iam_runtime and the three db_loan_* users
IAM_DB_PASSWORD=
LOAN_DB_READER01_PASSWORD=
LOAN_DB_READER02_PASSWORD=
LOAN_DB_LIBRARIAN01_PASSWORD=
# First run only: two different application login passwords, 12-256 characters
IAM_SEED_READER01_PASSWORD=
IAM_SEED_READER02_PASSWORD=

# Catalog service (compose.web.yaml)
CATALOG_DB_READER01_PASSWORD=
CATALOG_DB_READER02_PASSWORD=
CATALOG_DB_LIBRARIAN01_PASSWORD=

# Report service (compose.web.yaml): db_report_analyst01 and db_report_sync
REPORT_DB_ANALYST_PASSWORD=
REPORT_DB_SYNC_PASSWORD=
# Generate a private random token of at least 32 characters to enable loan synchronization.
REPORT_SYNC_TOKEN=
# First analyst login only (compose.analyst-seed.yaml), 12-256 characters
IAM_SEED_ANALYST01_PASSWORD=

# dbops-service (compose.web.yaml): 数据库管理员口令，供 gs_dump / gs_restore / gs_ctl 使用
# 不要写进仓库；复制 .env.example 为 .env 后填写
OPS_DB_PASSWORD=
# 数据库容器名（默认与 D 的本地演示库一致）
OPS_DB_CONTAINER=library-opengauss
# 主备演示时填备节点容器名，留空表示单实例
OPS_STANDBY_CONTAINER=
# 页面上展示的节点地址（宿主机映射端口）
OPS_NODE_A_HOST=127.0.0.1
OPS_NODE_A_PORT=15432
OPS_NODE_B_HOST=127.0.0.1
OPS_NODE_B_PORT=15433
